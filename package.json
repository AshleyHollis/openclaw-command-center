{
  "name": "openclaw-command-center",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The Command Center external Control UI plugin for OpenClaw.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test --test-isolation=none test/*.test.mjs"
  },
  "dependencies": {
    "openclaw": "2026.8.1-beta.2"
  },
  "devDependencies": {
    "playwright": "1.62.1",
    "playwright-core": "1.62.1"
  },
  "commandCenter": {
    "runtimeCapability": {
      "id": "openclaw-control-ui-v1",
      "sourceGraph": "./runtime-capability.source-graph.json"
    },
    "compatibilityTuple": {
      "formatVersion": 1,
      "host": { "range": "=2026.8.1-beta.2", "commit": "8f382a202ff1e15833394b481615dcdda99b04d7" },
      "pluginApi": { "package": "openclaw", "range": "=2026.8.1-beta.2" },
      "commandCenterSchema": { "readable": { "min": 1, "max": 1 }, "writable": { "min": 1, "max": 1 } },
      "capabilityBridgeProtocol": { "min": 1, "max": 1 }
    }
  },
  "openclaw": {
    "extensions": ["./dist/plugin.mjs"],
    "compat": {
      "pluginApi": "=2026.8.1-beta.2"
    }
  }
}
